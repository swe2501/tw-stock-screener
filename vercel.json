{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "apps/web/logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "apps/web/group-catalog.js",
      "use": "@vercel/static"
    },
    {
      "src": "group-catalog.json",
      "use": "@vercel/static"
    },
    {
      "src": "apps/web/group-logos.js",
      "use": "@vercel/static"
    },
    {
      "src": "apps/web/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "apps/web/treasury-research.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/site_search(?:\\.py)?$",
      "dest": "/api/prices.py?action=site_search"
    },
    {
      "src": "/api/([^/.]+)(?:\\.py)?$",
      "dest": "/api/$1.py"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/assets/(.*)",
      "dest": "/apps/web/assets/$1"
    },
    {
      "src": "/(logo\\.png|group-catalog\\.js|group-logos\\.js|treasury-research\\.html)$",
      "dest": "/apps/web/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/web/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/alert",
      "schedule": "35 5 * * 1-5"
    },
    {
      "path": "/api/alert?kind=sell",
      "schedule": "0 13 * * 1-5"
    }
  ],
  "ignoreCommand": "node scripts/should_build_web.cjs",
  "git": {
    "deploymentEnabled": {
      "app/**": false
    }
  }
}
